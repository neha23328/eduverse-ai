# Copy this file to .env and fill in your values

# Get a free Gemini API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Secret key for JWT signing - change this to any random string
SECRET_KEY=change_this_to_a_random_secret_string_in_production

# Database (SQLite file, no setup needed)
DATABASE_URL=sqlite:///./eduverse.db

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Expo / speed settings (all optional) ---
# Current fast model (gemini-2.0-flash has been retired).
GEMINI_MODEL=gemini-3.8-flash
# true = serve cached/offline content if Gemini is slow, down or out of quota
OFFLINE_FALLBACK=true
# true = never call Gemini; only cached + offline content (no-internet venue)
DEMO_MODE=false
# give up on Gemini after this many seconds and use the fallback
AI_TIMEOUT_SECONDS=25

# --- RAG (My Notes) ---
# semantic search with Gemini embeddings; falls back to keyword search if it fails
USE_EMBEDDINGS=true
EMBED_MODEL=gemini-embedding-001

# RAG tuning (optional)
RAG_TOP_K=5
RAG_MIN_COSINE=0.60
RAG_MIN_COVERAGE=0.5
